# ---------------------------------------------------------------------------
# Storyblok
# ---------------------------------------------------------------------------
# Leave everything unset to run against the bundled demo shelf (src/lib/mock-books.ts).

# Content Delivery API token from Space Settings → Access Tokens.
# Use a "Preview" token together with STORYBLOK_VERSION=draft while authoring,
# or a "Public" token with STORYBLOK_VERSION=published in production.
STORYBLOK_PREVIEW_TOKEN=

# published | draft   (default: published)
STORYBLOK_VERSION=published

# Folder inside the space that holds the book stories (default: books)
STORYBLOK_BOOKS_FOLDER=books

# Regional spaces: https://api-us.storyblok.com, https://api-ap.storyblok.com,
# https://api-ca.storyblok.com, https://app.storyblokchina.cn
STORYBLOK_API_URL=https://api.storyblok.com

# Shared secret for the /api/revalidate webhook. Unset ⇒ the endpoint stays off.
STORYBLOK_REVALIDATE_SECRET=
